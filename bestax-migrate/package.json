{
  "name": "bestax-migrate",
  "version": "2.34.1",
  "description": "Codemods for migrating existing React apps from other Bulma libraries to @allxsmith/bestax-bulma",
  "type": "module",
  "bin": {
    "bestax-migrate": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src e2e",
    "typecheck": "tsc --noEmit",
    "validate:corpus": "pnpm run build && node scripts/validate-corpus.mjs",
    "validate:corpus:rbx": "pnpm run build && node scripts/validate-corpus-rbx.mjs",
    "validate:corpus:bloomer": "pnpm run build && node scripts/validate-corpus-bloomer.mjs",
    "validate:corpus:bulma-classes": "pnpm run build && node scripts/validate-corpus-bulma-classes.mjs",
    "validate:corpus:templates": "pnpm run build && node scripts/validate-corpus-templates.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\"",
    "clean": "rimraf dist",
    "release": "npx semantic-release",
    "prepack": "node ../scripts/require-pnpm-publish.mjs",
    "prepublishOnly": "node ../scripts/require-pnpm-publish.mjs"
  },
  "keywords": [
    "bestax",
    "bulma",
    "react",
    "codemod",
    "jscodeshift",
    "migration",
    "react-bulma-components"
  ],
  "author": "Alex Smith",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allxsmith/bestax.git",
    "directory": "bestax-migrate"
  },
  "homepage": "https://bestax.io",
  "llms": "https://bestax.io/llms.txt",
  "bugs": {
    "url": "https://github.com/allxsmith/bestax/issues"
  },
  "dependencies": {
    "@allxsmith/bestax-bulma": "workspace:^",
    "@babel/parser": "^7.29.11",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "jscodeshift": "^17.3.0",
    "parse5": "^8.0.1",
    "property-information": "^7.2.0"
  },
  "devDependencies": {
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-istanbul": "^5.0.5",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
