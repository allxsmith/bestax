{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "webworker"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  // Tests run under Vitest and use Node's own modules, whose types aren't
  // loaded here (no @types/node with types: []) — src only.
  "exclude": ["src/__tests__"]
}
