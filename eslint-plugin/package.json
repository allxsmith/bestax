{
  "name": "@allxsmith/eslint-plugin-bestax",
  "version": "1.0.2",
  "description": "ESLint rules for @allxsmith/bestax-bulma — catches helper-prop values the library silently drops, deprecated props, and the color-as-surface mistake",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch",
    "test:coverage": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rimraf dist",
    "release": "npx semantic-release",
    "prepack": "node ../scripts/require-pnpm-publish.mjs",
    "prepublishOnly": "node ../scripts/require-pnpm-publish.mjs"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "bestax",
    "bulma",
    "react",
    "typescript",
    "lint",
    "helper-props"
  ],
  "author": "Alex Smith",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allxsmith/bestax.git",
    "directory": "eslint-plugin"
  },
  "homepage": "https://bestax.io/docs/guides/getting-started/eslint-plugin",
  "llms": "https://bestax.io/llms.txt",
  "bugs": {
    "url": "https://github.com/allxsmith/bestax/issues"
  },
  "dependencies": {
    "@allxsmith/bestax-bulma": "workspace:^"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
