{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "watch": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {},
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "bestax-mcp#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/skills/**"],
      "outputs": ["dist/**", "data/skills/**"]
    },
    "bestax-mcp#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/bestax-migrate/src/sources/bulma-classes/**"
      ]
    },
    "bestax-mcp#test:coverage": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/bestax-migrate/src/sources/bulma-classes/**"
      ],
      "outputs": ["coverage/**"]
    },
    "create-bestax#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/skills/**"],
      "outputs": ["dist/**", "templates/skills/**"]
    },
    "bestax-migrate#test": {
      "dependsOn": ["@allxsmith/bestax-bulma#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/bestax-mcp/data/components/**"
      ]
    },
    "bestax-migrate#test:coverage": {
      "dependsOn": ["@allxsmith/bestax-bulma#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/bestax-mcp/data/components/**"
      ],
      "outputs": ["coverage/**"]
    },
    "@allxsmith/eslint-plugin-bestax#typecheck": {
      "dependsOn": ["@allxsmith/bestax-bulma#build"]
    },
    "@allxsmith/eslint-plugin-bestax#test": {
      "dependsOn": ["@allxsmith/bestax-bulma#build"]
    },
    "@allxsmith/eslint-plugin-bestax#test:coverage": {
      "dependsOn": ["@allxsmith/bestax-bulma#build"],
      "outputs": ["coverage/**"]
    },
    "bundle:stats": {
      "outputs": ["dist/**"]
    },
    "typecheck": {},
    "typecheck:tests": {},
    "format": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "lint": {},
    "storybook": {
      "cache": true
    },
    "docs": {
      "cache": true
    },
    "release": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"]
    }
  }
}
