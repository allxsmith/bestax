{
  "name": "@allxsmith/bestax-bulma",
  "version": "5.57.4",
  "description": "Component library based on React, Bulma, with Agent Skills and MCP",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "src/scss",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "AGENTS.md",
    "CLAUDE.md",
    "llms.txt"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c --watch",
    "watch": "rollup -c --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bundle:stats": "rollup -c --configPlugin visualizer",
    "lint": "eslint src .storybook vitest.config.ts vitest.storybook.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "clean": "rimraf dist",
    "storybook": "storybook dev -p 6006",
    "start": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "npx semantic-release",
    "test-storybook": "vitest run --config vitest.storybook.config.ts",
    "test-storybook:dark": "STORYBOOK_THEME=dark vitest run --config vitest.storybook.config.ts",
    "test-storybook:ci": "node scripts/test-storybook-ci.mjs",
    "prepack": "node ../scripts/require-pnpm-publish.mjs && node scripts/pack-pointer-files.mjs prepack",
    "prepublishOnly": "node ../scripts/require-pnpm-publish.mjs",
    "postpack": "node scripts/pack-pointer-files.mjs postpack"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@guidepup/virtual-screen-reader": "0.33.0",
    "@mdi/font": "^7.4.47",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.3.1",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-onboarding": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.5",
    "ionicons": "^8.1.0",
    "jsdom": "^30.1.3",
    "material-icons": "^1.13.14",
    "material-symbols": "^0.48.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "rimraf": "^6.0.1",
    "rollup": "^4.66.0",
    "rollup-plugin-scss": "^4.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.107.0",
    "sass-embedded": "^1.107.0",
    "storybook": "^10.6.5",
    "tslib": "^2.8.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "bulma": "^1.0.4"
  },
  "peerDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2 || ^7.0.0",
    "@mdi/font": "^7.4.47",
    "ionicons": "^8.0.0",
    "material-icons": "^1.13.10",
    "material-symbols": "^0.34.1 || ^0.45.0 || ^0.46.0 || ^0.47.0 || ^0.48.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@fortawesome/fontawesome-free": {
      "optional": true
    },
    "@mdi/font": {
      "optional": true
    },
    "ionicons": {
      "optional": true
    },
    "material-icons": {
      "optional": true
    },
    "material-symbols": {
      "optional": true
    }
  },
  "keywords": [
    "bestax",
    "react",
    "bulma",
    "typescript",
    "components",
    "ai",
    "llms",
    "agents",
    "agent-skills"
  ],
  "typesVersions": {
    "*": {
      "constants": [
        "./dist/types/helpers/bulmaClassHelpers.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/types-cjs/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./constants": {
      "import": {
        "types": "./dist/types/helpers/bulmaClassHelpers.d.ts",
        "default": "./dist/constants.esm.js"
      },
      "require": {
        "types": "./dist/constants.d.cts",
        "default": "./dist/constants.cjs"
      }
    },
    "./dist/extras.css": {
      "default": "./dist/extras.css"
    },
    "./extras.css": {
      "default": "./dist/extras.css"
    },
    "./dist/bestax.css": {
      "default": "./dist/bestax.css"
    },
    "./bestax.css": {
      "default": "./dist/bestax.css"
    },
    "./bestax.min.css": {
      "default": "./dist/bestax.css"
    },
    "./dist/bestax.min.css": {
      "default": "./dist/bestax.css"
    },
    "./versions/bestax-prefixed.css": {
      "default": "./dist/versions/bestax-prefixed.css"
    },
    "./dist/versions/bestax-prefixed.css": {
      "default": "./dist/versions/bestax-prefixed.css"
    },
    "./versions/bestax-no-helpers.css": {
      "default": "./dist/versions/bestax-no-helpers.css"
    },
    "./dist/versions/bestax-no-helpers.css": {
      "default": "./dist/versions/bestax-no-helpers.css"
    },
    "./versions/bestax-no-helpers-prefixed.css": {
      "default": "./dist/versions/bestax-no-helpers-prefixed.css"
    },
    "./dist/versions/bestax-no-helpers-prefixed.css": {
      "default": "./dist/versions/bestax-no-helpers-prefixed.css"
    },
    "./versions/bestax-no-dark-mode.css": {
      "default": "./dist/versions/bestax-no-dark-mode.css"
    },
    "./dist/versions/bestax-no-dark-mode.css": {
      "default": "./dist/versions/bestax-no-dark-mode.css"
    },
    "./scss": {
      "default": "./src/scss/extras.scss"
    },
    "./scss/bestax": {
      "default": "./src/scss/bestax.scss"
    },
    "./scss/*": {
      "default": "./src/scss/*"
    }
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/allxsmith"
  },
  "engines": {
    "node": ">=16",
    "npm": ">=7"
  },
  "author": "Alex Smith",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allxsmith/bestax.git",
    "directory": "bulma-ui"
  },
  "homepage": "https://bestax.io",
  "llms": "https://bestax.io/llms.txt",
  "bugs": {
    "url": "https://github.com/allxsmith/bestax/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
