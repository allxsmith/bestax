{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "src/__tests__/**/*.ts",
    "src/__tests__/**/*.tsx",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "types/**/*",
    ".storybook/**/*.ts",
    "vitest.config.ts",
    "vitest.storybook.config.ts"
  ],
  "exclude": ["node_modules", "dist", "build"]
}
