{
  "name": "create-bestax",
  "version": "4.7.1",
  "description": "Create a new bestax-bulma project",
  "type": "module",
  "bin": {
    "create-bestax": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "node scripts/sync-skills.mjs && tsc",
    "prepack": "node ../scripts/require-pnpm-publish.mjs && node scripts/sync-skills.mjs",
    "prepublishOnly": "node ../scripts/require-pnpm-publish.mjs",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
    "test:e2e:update": "playwright test --config=e2e/playwright.config.ts --update-snapshots",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "lint": "eslint src e2e/tests e2e/utils",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "clean": "rimraf dist",
    "release": "npx semantic-release"
  },
  "keywords": [
    "bestax",
    "bulma",
    "react",
    "create",
    "cli",
    "scaffold"
  ],
  "author": "Alex Smith",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allxsmith/bestax.git",
    "directory": "create-bestax"
  },
  "homepage": "https://bestax.io",
  "llms": "https://bestax.io/llms.txt",
  "bugs": {
    "url": "https://github.com/allxsmith/bestax/issues"
  },
  "dependencies": {
    "@allxsmith/bestax-bulma": "workspace:^",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "figures": "^6.1.0",
    "fs-extra": "^11.4.1",
    "prompts": "^2.4.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@types/prompts": "^2.4.9",
    "@types/wait-on": "^5.3.4",
    "@vitest/coverage-istanbul": "^5.0.5",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
