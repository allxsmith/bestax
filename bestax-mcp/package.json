{
  "name": "bestax-mcp",
  "version": "1.18.26",
  "mcpName": "io.github.allxsmith/bestax-mcp",
  "description": "MCP server for @allxsmith/bestax-bulma — component props, examples, CSS variables and agent skills, served offline from a version-pinned index",
  "type": "module",
  "bin": {
    "bestax-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "!data/.sync-skills"
  ],
  "scripts": {
    "build": "node scripts/sync-skills.mjs && tsc",
    "dev": "tsc --watch",
    "test": "node scripts/sync-skills.mjs && vitest run",
    "test:watch": "node scripts/sync-skills.mjs && vitest",
    "test:coverage": "node scripts/sync-skills.mjs && vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rimraf dist",
    "release": "npx semantic-release",
    "prepack": "node ../scripts/require-pnpm-publish.mjs && node scripts/sync-skills.mjs",
    "prepublishOnly": "node ../scripts/require-pnpm-publish.mjs"
  },
  "keywords": [
    "bestax",
    "bulma",
    "react",
    "mcp",
    "model-context-protocol",
    "ai",
    "agents",
    "llms",
    "components",
    "documentation"
  ],
  "author": "Alex Smith",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allxsmith/bestax.git",
    "directory": "bestax-mcp"
  },
  "homepage": "https://bestax.io/docs/guides/llms",
  "llms": "https://bestax.io/llms.txt",
  "bugs": {
    "url": "https://github.com/allxsmith/bestax/issues"
  },
  "dependencies": {
    "@allxsmith/bestax-bulma": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-istanbul": "^5.0.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
