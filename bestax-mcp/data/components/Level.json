{
  "name": "Level",
  "kind": "component",
  "category": "layout",
  "slug": "layout/level",
  "docsUrl": "https://bestax.io/docs/api/layout/level",
  "examples": [
    {
      "title": "Default Level",
      "code": "<Level>\n  <Level.Left>\n    <Level.Item>\n      <SubTitle as=\"p\" size=\"5\">\n        <Strong>Favorite Posts</Strong>\n      </SubTitle>\n    </Level.Item>\n    <Level.Item>\n      <Field hasAddons>\n        <Control>\n          <Input type=\"text\" placeholder=\"Find a post\" />\n        </Control>\n        <Control>\n          <Button>Search</Button>\n        </Control>\n      </Field>\n    </Level.Item>\n  </Level.Left>\n  <Level.Right>\n    <Level.Item as=\"p\">\n      <Strong>All</Strong>\n    </Level.Item>\n    <Level.Item as=\"p\">\n      <Link>Published</Link>\n    </Level.Item>\n    <Level.Item as=\"p\">\n      <Link>Drafts</Link>\n    </Level.Item>\n    <Level.Item as=\"p\">\n      <Link>Deleted</Link>\n    </Level.Item>\n    <Level.Item as=\"p\">\n      <Button color=\"success\" as=\"a\">\n        New\n      </Button>\n    </Level.Item>\n  </Level.Right>\n</Level>"
    },
    {
      "title": "Centered Level (Statistics)",
      "code": "<Level>\n  <Level.Item hasTextCentered>\n    <Block>\n      <Paragraph className=\"heading\">Posts</Paragraph>\n      <Title as=\"p\">1,234</Title>\n    </Block>\n  </Level.Item>\n  <Level.Item hasTextCentered>\n    <Block>\n      <Paragraph className=\"heading\">Following</Paragraph>\n      <Title as=\"p\">6789</Title>\n    </Block>\n  </Level.Item>\n  <Level.Item hasTextCentered>\n    <Block>\n      <Paragraph className=\"heading\">Followers</Paragraph>\n      <Title as=\"p\">123K</Title>\n    </Block>\n  </Level.Item>\n  <Level.Item hasTextCentered>\n    <Block>\n      <Paragraph className=\"heading\">Likes</Paragraph>\n      <Title as=\"p\">9876</Title>\n    </Block>\n  </Level.Item>\n</Level>"
    },
    {
      "title": "Centered Level Menu",
      "code": "<Level>\n  <Level.Item as=\"p\" hasTextCentered>\n    <Link textColor=\"info\">Getting Started</Link>\n  </Level.Item>\n  <Level.Item as=\"p\" hasTextCentered>\n    <Link textColor=\"info\">APIs</Link>\n  </Level.Item>\n  <Level.Item as=\"p\" hasTextCentered>\n    <img src=\"/img/bestax-type.svg\" alt=\"Bestax\" style={{ height: 30 }} />\n  </Level.Item>\n  <Level.Item as=\"p\" hasTextCentered>\n    <Link textColor=\"info\">Versions</Link>\n  </Level.Item>\n  <Level.Item as=\"p\" hasTextCentered>\n    <Link textColor=\"info\">FAQ</Link>\n  </Level.Item>\n</Level>"
    },
    {
      "title": "Mobile Level",
      "code": "<Level isMobile>\n  <Level.Item hasTextCentered>\n    <Block>\n      <Paragraph className=\"heading\">Posts</Paragraph>\n      <Title as=\"p\">1,234</Title>\n    </Block>\n  </Level.Item>\n  <Level.Item hasTextCentered>\n    <Block>\n      <Paragraph className=\"heading\">Following</Paragraph>\n      <Title as=\"p\">4567</Title>\n    </Block>\n  </Level.Item>\n  <Level.Item hasTextCentered>\n    <Block>\n      <Paragraph className=\"heading\">Followers</Paragraph>\n      <Title as=\"p\">123K</Title>\n    </Block>\n  </Level.Item>\n  <Level.Item hasTextCentered>\n    <Block>\n      <Paragraph className=\"heading\">Likes</Paragraph>\n      <Title as=\"p\">9876</Title>\n    </Block>\n  </Level.Item>\n</Level>"
    },
    {
      "title": "Compound (dot-notation) usage",
      "code": "<Level>\n  <Level.Left>\n    <Level.Item>\n      <Title as=\"p\" size=\"5\">\n        <strong>All Posts</strong>\n      </Title>\n    </Level.Item>\n  </Level.Left>\n  <Level.Right>\n    <Level.Item as=\"p\">\n      <a>Published</a>\n    </Level.Item>\n    <Level.Item as=\"p\">\n      <Button color=\"success\" as=\"a\">\n        New\n      </Button>\n    </Level.Item>\n  </Level.Right>\n</Level>"
    }
  ],
  "accessibility": "- The root `Level` renders as a semantic `<nav>` for grouping and navigation.\n- Items can be rendered as `<div>`, `<p>`, or `<a>`. Use `as=\"a\"` for links, and provide clear text or accessible labels.\n- Use Bulma helper props for spacing and color to improve contrast and readability.\n\n:::note\nFor best accessibility, use semantic elements for headings/content within items, and ensure interactive elements (like `Button` or links) are focusable and labeled.\n:::",
  "related": ["Button", "Field", "Input", "Title", "useBulmaClasses"],
  "storybook": "https://bestax.io/storybook/?path=/story/layout-level--default",
  "summary": "The `Level` component provides a flexible horizontal layout for your Bulma React UI, perfect for aligning items on the left and right, distributing items evenly, or centering statistics and controls.",
