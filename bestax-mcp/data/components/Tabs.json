    },
    {
      "title": "Small, Medium, and Large Tabs",
      "code": "<>\n  <Tabs size=\"small\">\n    <Tabs.List>\n      <Tabs.Item active>\n        <a>Tab 1</a>\n      </Tabs.Item>\n      <Tabs.Item>\n        <a>Tab 2</a>\n      </Tabs.Item>\n      <Tabs.Item>\n        <a>Tab 3</a>\n      </Tabs.Item>\n    </Tabs.List>\n  </Tabs>\n\n  <Tabs size=\"medium\">\n    <Tabs.List>\n      <Tabs.Item active>\n        <a>Tab 1</a>\n      </Tabs.Item>\n      <Tabs.Item>\n        <a>Tab 2</a>\n      </Tabs.Item>\n      <Tabs.Item>\n        <a>Tab 3</a>\n      </Tabs.Item>\n    </Tabs.List>\n  </Tabs>\n\n  <Tabs size=\"large\">\n    <Tabs.List>\n      <Tabs.Item active>\n        <a>Tab 1</a>\n      </Tabs.Item>\n      <Tabs.Item>\n        <a>Tab 2</a>\n      </Tabs.Item>\n      <Tabs.Item>\n        <a>Tab 3</a>\n      </Tabs.Item>\n    </Tabs.List>\n  </Tabs>\n</>"
    },
    {
      "title": "Boxed Tabs",
      "code": "<Tabs boxed>\n  <Tabs.List>\n    <Tabs.Item active>\n      <a>Overview</a>\n    </Tabs.Item>\n    <Tabs.Item>\n      <a>Elements</a>\n    </Tabs.Item>\n    <Tabs.Item>\n      <a>Components</a>\n    </Tabs.Item>\n  </Tabs.List>\n</Tabs>"
