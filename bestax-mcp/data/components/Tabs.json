    {
      "title": "Centered Alignment",
      "code": "<Tabs align=\"centered\">\n  <Tabs.List>\n    <Tabs.Item active>\n      <a>Home</a>\n    </Tabs.Item>\n    <Tabs.Item>\n      <a>Profile</a>\n    </Tabs.Item>\n    <Tabs.Item>\n      <a>Settings</a>\n    </Tabs.Item>\n  </Tabs.List>\n</Tabs>"
    },
    {
      "title": "Right Alignment",
      "code": "<Tabs align=\"right\">\n  <Tabs.List>\n    <Tabs.Item>\n      <a>Home</a>\n    </Tabs.Item>\n    <Tabs.Item active>\n      <a>Profile</a>\n    </Tabs.Item>\n    <Tabs.Item>\n      <a>Settings</a>\n    </Tabs.Item>\n  </Tabs.List>\n</Tabs>"
