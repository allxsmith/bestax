      "code": "<Tabs align=\"centered\" boxed size=\"medium\">\n  <Tabs.List>\n    <Tabs.Item active>\n      <a>\n        <Icon name=\"fas fa-star\" size=\"small\" />\n        <span>Favorites</span>\n      </a>\n    </Tabs.Item>\n    <Tabs.Item>\n      <a>\n        <Icon name=\"fas fa-clock\" size=\"small\" />\n        <span>Recent</span>\n      </a>\n    </Tabs.Item>\n    <Tabs.Item>\n      <a>\n        <Icon name=\"fas fa-archive\" size=\"small\" />\n        <span>Archive</span>\n      </a>\n    </Tabs.Item>\n  </Tabs.List>\n</Tabs>"
