      "code": "<Tabs toggle isFullwidth size=\"large\">\n  <Tabs.List>\n    <Tabs.Item active>\n      <a>\n        <Icon name=\"fas fa-rocket\" size=\"small\" />\n        <span>Launch</span>\n      </a>\n    </Tabs.Item>\n    <Tabs.Item>\n      <a>\n        <Icon name=\"fas fa-bell\" size=\"small\" />\n        <span>Alerts</span>\n      </a>\n    </Tabs.Item>\n    <Tabs.Item>\n      <a>\n        <Icon name=\"fas fa-cogs\" size=\"small\" />\n        <span>Settings</span>\n      </a>\n    </Tabs.Item>\n  </Tabs.List>\n</Tabs>"
    },
    {
      "title": "Compound (dot-notation) usage",
      "code": "<Tabs>\n  <Tabs.List>\n    <Tabs.Tab index={0}>Overview</Tabs.Tab>\n    <Tabs.Tab index={1}>Settings</Tabs.Tab>\n  </Tabs.List>\n  <Tabs.Content>\n    <Tabs.Content.Item index={0}>Overview panel</Tabs.Content.Item>\n    <Tabs.Content.Item index={1}>Settings panel</Tabs.Content.Item>\n  </Tabs.Content>\n</Tabs>"
    }
