{
  "name": "Navbar",
  "kind": "component",
  "category": "components",
  "slug": "components/navbar",
  "docsUrl": "https://bestax.io/docs/api/components/navbar",
  "examples": [
    {
      "title": "Complete Navbar with Burger and Menu",
      "code": "function example() {\n  const [active, setActive] = useState(false);\n\n  return (\n    <Navbar>\n      <Navbar.Brand>\n        <Navbar.Item href=\"#\">\n          <img src=\"/img/logo.svg\" alt=\"Logo\" width=\"28\" height=\"28\" />\n        </Navbar.Item>\n        <Navbar.Burger\n          active={active}\n          onClick={() => setActive(a => !a)}\n          aria-label=\"menu\"\n          aria-expanded={active}\n        />\n      </Navbar.Brand>\n      <Navbar.Menu active={active}>\n        <Navbar.Start>\n          <Navbar.Item href=\"#\">Home</Navbar.Item>\n          <Navbar.Item href=\"#\">Docs</Navbar.Item>\n          <Navbar.Item href=\"#\">About</Navbar.Item>\n          <Navbar.Item href=\"#\">Contact</Navbar.Item>\n        </Navbar.Start>\n        <Navbar.End>\n          <Navbar.Item href=\"#\">Login</Navbar.Item>\n        </Navbar.End>\n      </Navbar.Menu>\n    </Navbar>\n  );\n}"
    },
    {
      "title": "Brand Only",
      "code": "<Navbar>\n  <Navbar.Brand>\n    <Navbar.Item href=\"#\">\n      <img src=\"/img/logo.svg\" alt=\"Logo\" width=\"28\" height=\"28\" />\n    </Navbar.Item>\n  </Navbar.Brand>\n</Navbar>"
    },
    {
      "title": "Burger Only",
      "code": "<Navbar>\n  <Navbar.Burger\n    aria-label=\"menu\"\n    aria-expanded={false}\n    style={{ display: 'flex' }}\n  />\n</Navbar>"
    },
    {
      "title": "Burger Active",
      "code": "<Navbar>\n  <Navbar.Burger\n    active\n    aria-label=\"menu\"\n    aria-expanded\n    style={{ display: 'flex' }}\n  />\n</Navbar>"
    },
    {
      "title": "Menu with Start and End",
      "code": "<Navbar>\n  <Navbar.Menu active>\n    <Navbar.Start>\n      <Navbar.Item href=\"#\">Home</Navbar.Item>\n    </Navbar.Start>\n    <Navbar.End>\n      <Navbar.Item href=\"#\">Login</Navbar.Item>\n    </Navbar.End>\n  </Navbar.Menu>\n</Navbar>"
    },
    {
      "title": "Navigation Links and Dropdowns",
      "code": "<Navbar>\n  <Navbar.Brand>\n    <Navbar.Item>\n      <img src=\"/img/logo.svg\" alt=\"Logo\" width=\"28\" height=\"28\" />\n    </Navbar.Item>\n  </Navbar.Brand>\n  <Navbar.Menu active>\n    <Navbar.Start>\n      <Navbar.Item href=\"#\">Home</Navbar.Item>\n      <Navbar.Item href=\"#\">Docs</Navbar.Item>\n      <Navbar.Dropdown hoverable>\n        <Navbar.Link>More</Navbar.Link>\n        <Navbar.DropdownMenu>\n          <Navbar.Item href=\"#\">About</Navbar.Item>\n          <Navbar.Item href=\"#\">Jobs</Navbar.Item>\n          <Navbar.Item href=\"#\">Contact</Navbar.Item>\n          <Navbar.Divider />\n          <Navbar.Item href=\"#\">Report an issue</Navbar.Item>\n        </Navbar.DropdownMenu>\n      </Navbar.Dropdown>\n    </Navbar.Start>\n  </Navbar.Menu>\n</Navbar>"
    },
    {
      "title": "Custom Link Component",
      "code": "// import { Link } from 'react-router-dom';\nfunction example() {\n  const Link = props => <a>{props.children}</a>;\n  return (\n    <Navbar>\n      <Navbar.Menu active>\n        <Navbar.Start>\n          <Navbar.Item as={Link} to=\"/\">\n            Home\n          </Navbar.Item>\n          <Navbar.Item as={Link} to=\"/pricing\">\n            Pricing\n          </Navbar.Item>\n        </Navbar.Start>\n      </Navbar.Menu>\n    </Navbar>\n  );\n}"
    },
    {
      "title": "Transparent Navbar",
      "code": "<Navbar transparent>{/* ...brand and menu... */}</Navbar>"
    },
    {
      "title": "Fixed Navbar",
      "code": "<Navbar fixed=\"top\">{/* ...brand and menu... */}</Navbar>"
    },
    {
      "title": "Dropdown Right",
      "code": "<Navbar>\n  <Navbar.Menu active>\n    <Navbar.End>\n      <Navbar.Dropdown hoverable right>\n        <Navbar.Link>Right Dropdown</Navbar.Link>\n        <Navbar.DropdownMenu right>\n          <Navbar.Item href=\"#\">Profile</Navbar.Item>\n          <Navbar.Item href=\"#\">Settings</Navbar.Item>\n        </Navbar.DropdownMenu>\n      </Navbar.Dropdown>\n    </Navbar.End>\n  </Navbar.Menu>\n</Navbar>"
    },
    {
      "title": "Dropup",
      "code": "<>\n  <Hero color=\"primary\" size=\"small\">\n    <Hero.Body>\n      <Title>Hero above Navbar</Title>\n      <SubTitle>Hover \"Dropup\" below to see the menu open upward</SubTitle>\n    </Hero.Body>\n  </Hero>\n  <Navbar>\n    <Navbar.Menu active>\n      <Navbar.Start>\n        <Navbar.Dropdown hoverable up>\n          <Navbar.Link>Dropup</Navbar.Link>\n          <Navbar.DropdownMenu up>\n            <Navbar.Item href=\"#\">Up1</Navbar.Item>\n            <Navbar.Item href=\"#\">Up2</Navbar.Item>\n          </Navbar.DropdownMenu>\n        </Navbar.Dropdown>\n      </Navbar.Start>\n    </Navbar.Menu>\n  </Navbar>\n</>"
    },
    {
      "title": "Dropdown without Arrow",
      "code": "<Navbar>\n  <Navbar.Menu active>\n    <Navbar.Start>\n      <Navbar.Dropdown hoverable>\n        <Navbar.Link arrowless>No Arrow</Navbar.Link>\n        <Navbar.DropdownMenu>\n          <Navbar.Item href=\"#\">A</Navbar.Item>\n          <Navbar.Item href=\"#\">B</Navbar.Item>\n        </Navbar.DropdownMenu>\n      </Navbar.Dropdown>\n    </Navbar.Start>\n  </Navbar.Menu>\n</Navbar>"
    },
    {
      "title": "Active Dropdown Item",
      "code": "<Navbar>\n  <Navbar.Menu active>\n    <Navbar.Start>\n      <Navbar.Dropdown active>\n        <Navbar.Link>Active Dropdown</Navbar.Link>\n        <Navbar.DropdownMenu>\n          <Navbar.Item href=\"#\">A1</Navbar.Item>\n          <Navbar.Item href=\"#\">A2</Navbar.Item>\n        </Navbar.DropdownMenu>\n      </Navbar.Dropdown>\n    </Navbar.Start>\n  </Navbar.Menu>\n</Navbar>"
    },
    {
      "title": "Dropdown with Divider",
      "code": "<Navbar>\n  <Navbar.Menu active>\n    <Navbar.Start>\n      <Navbar.Dropdown hoverable>\n        <Navbar.Link>With Divider</Navbar.Link>\n        <Navbar.DropdownMenu>\n          <Navbar.Item href=\"#\">One</Navbar.Item>\n          <Navbar.Item href=\"#\">Two</Navbar.Item>\n          <Navbar.Divider />\n          <Navbar.Item href=\"#\">Three</Navbar.Item>\n        </Navbar.DropdownMenu>\n      </Navbar.Dropdown>\n    </Navbar.Start>\n  </Navbar.Menu>\n</Navbar>"
    },
    {
      "title": "Color Modifiers",
      "code": "function example() {\n  const colors = [\n    'primary',\n    'link',\n    'info',\n    'success',\n    'warning',\n    'danger',\n    'black',\n    'dark',\n    'light',\n    'white',\n  ];\n  return (\n    <>\n      {colors.map(color => (\n        <Navbar key={color} color={color} mb=\"2\">\n          <Navbar.Brand>\n            <Navbar.Item href=\"#\">\n              <img src=\"/img/logo.svg\" alt=\"Logo\" width=\"28\" height=\"28\" />\n            </Navbar.Item>\n          </Navbar.Brand>\n          <Navbar.Menu active>\n            <Navbar.Start>\n              <Navbar.Item href=\"#\">Home</Navbar.Item>\n              <Navbar.Item href=\"#\">Docs</Navbar.Item>\n              <Navbar.Item href=\"#\">Components</Navbar.Item>\n            </Navbar.Start>\n          </Navbar.Menu>\n        </Navbar>\n      ))}\n    </>\n  );\n}"
    },
    {
      "title": "Compound (dot-notation) usage",
      "code": "<Navbar>\n  <Navbar.Brand>\n    <Navbar.Item href=\"#\">\n      <img src=\"/img/logo.svg\" alt=\"Logo\" width=\"28\" height=\"28\" />\n    </Navbar.Item>\n    <Navbar.Burger aria-label=\"menu\" />\n  </Navbar.Brand>\n  <Navbar.Menu active>\n    <Navbar.Start>\n      <Navbar.Item href=\"#\">Home</Navbar.Item>\n      <Navbar.Item href=\"#\">Docs</Navbar.Item>\n    </Navbar.Start>\n    <Navbar.End>\n      <Navbar.Item href=\"#\">Log in</Navbar.Item>\n    </Navbar.End>\n  </Navbar.Menu>\n</Navbar>"
    }
  ],
  "accessibility": "- The root `Navbar` renders as `<nav role=\"navigation\" aria-label=\"main navigation\">`.\n- Use semantic links (`<a>`) and buttons, and provide clear `aria-label` and `aria-expanded` for the burger toggle.\n- Dropdowns and menus follow Bulma's structure for keyboard and screen reader accessibility.\n\n:::note\nFor full accessibility in dropdowns, ensure that focus, keyboard navigation, and ARIA attributes are managed where needed.\n:::",
