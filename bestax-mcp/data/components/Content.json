    {
      "title": "Rich Content (all HTML tags, various sizes)",
      "code": "<Content size=\"small\" textColor=\"primary\" p=\"3\">\n  <h1>Lorem Ipsum Heading</h1>\n  <p>\n    Lorem ipsum dolor sit amet, <strong>consectetur adipiscing</strong> elit.\n  </p>\n  <ul>\n    <li>Lorem ipsum</li>\n    <li>Consectetur</li>\n    <li>Sed do eiusmod</li>\n  </ul>\n  <ol>\n    <li>First item</li>\n    <li>Second item</li>\n  </ol>\n  <blockquote>\n    Duis aute irure dolor in reprehenderit in voluptate velit esse cillum.\n  </blockquote>\n  <table>\n    <thead>\n      <tr>\n        <th>Header 1</th>\n        <th>Header 2</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td>Row 1, Cell 1</td>\n        <td>Row 1, Cell 2</td>\n      </tr>\n    </tbody>\n  </table>\n</Content>"
