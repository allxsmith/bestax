{
  "name": "Rate",
  "kind": "component",
  "category": "form",
  "slug": "form/rate",
  "docsUrl": "https://bestax.io/docs/api/form/rate",
  "examples": [
    {
      "title": "Basic Rating",
      "code": "function example() {\n  const [rating, setRating] = useState(3);\n  return (\n    <Block>\n      <Rate value={rating} onChange={setRating} />\n      <Paragraph mt=\"2\">Rating: {rating} stars</Paragraph>\n    </Block>\n  );\n}"
    },
    {
      "title": "With Score Display",
      "code": "function example() {\n  const [rating, setRating] = useState(4);\n  return <Rate value={rating} onChange={setRating} showScore />;\n}"
    },
    {
      "title": "With Text Labels",
      "code": "function example() {\n  const [rating, setRating] = useState(3);\n  return (\n    <Rate\n      value={rating}\n      onChange={setRating}\n      showText\n      texts={['Poor', 'Fair', 'Average', 'Good', 'Excellent']}\n    />\n  );\n}"
    },
    {
      "title": "With Score and Text",
      "code": "function example() {\n  const [rating, setRating] = useState(4);\n  return (\n    <Rate\n      value={rating}\n      onChange={setRating}\n      showScore\n      showText\n      texts={['Terrible', 'Bad', 'OK', 'Good', 'Great']}\n    />\n  );\n}"
    },
    {
      "title": "Size Variants",
      "code": "<Block display=\"flex\" flexDirection=\"column\" gap=\"4\">\n  <Rate defaultValue={3} size=\"small\" />\n  <Rate defaultValue={3} />\n  <Rate defaultValue={3} size=\"medium\" />\n  <Rate defaultValue={3} size=\"large\" />\n</Block>"
    },
    {
      "title": "Custom Max Value",
      "code": "function example() {\n  const [rating, setRating] = useState(7);\n  return (\n    <Block>\n      <Rate value={rating} onChange={setRating} max={10} showScore />\n      <Paragraph mt=\"2\">Rating: {rating} out of 10</Paragraph>\n    </Block>\n  );\n}"
    },
    { "title": "Spaced Icons", "code": "<Rate defaultValue={3} spaced />" },
    {
      "title": "Disabled Rating",
      "code": "<Rate value={4} disabled showScore />"
    },
    {
      "title": "Custom Icons",
      "code": "function example() {\n  const [rating, setRating] = useState(3);\n\n  const HeartIcon = ({ isActive }) => (\n    <svg\n      xmlns=\"http://www.w3.org/2000/svg\"\n      viewBox=\"0 0 24 24\"\n      fill={isActive ? 'currentColor' : 'none'}\n      stroke=\"currentColor\"\n      strokeWidth={isActive ? 0 : 2}\n      style={{ color: '#f14668' }}\n    >\n      <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\" />\n    </svg>\n  );\n\n  return (\n    <Rate\n      value={rating}\n      onChange={setRating}\n      customIcon={({ isActive }) => <HeartIcon isActive={isActive} />}\n      showScore\n    />\n  );\n}"
    },
    {
      "title": "Context-Aware Rendering",
      "code": "<Rate label=\"Rating\" defaultValue={3} />"
    },
    {
      "title": "Context-Aware Rendering",
      "code": "function example() {\n  return (\n    <Field horizontal label=\"Rating\">\n      <Field.Body>\n        <Field>\n          <Rate defaultValue={3} />\n        </Field>\n      </Field.Body>\n    </Field>\n  );\n}"
    },
    {
      "title": "Context-Aware Rendering",
      "code": "function example() {\n  return (\n    <Field horizontal label=\"Rating\">\n      <Field.Body>\n        <Field>\n          <Control iconLeftName=\"star\">\n            <Rate defaultValue={3} />\n          </Control>\n        </Field>\n      </Field.Body>\n    </Field>\n  );\n}"
    }
  ],
  "accessibility": "- Uses `role=\"radiogroup\"` for the container\n- Each star has `role=\"radio\"` with `aria-checked`\n- Has `aria-valuenow`, `aria-valuemin`, and `aria-valuemax`\n- Full keyboard navigation with arrow keys\n- Home/End keys jump to 0/max values",
  "related": ["Input", "Slider"],
