  "docsUrl": "https://bestax.io/docs/api/components/pagination",
  "examples": [
    {
      "title": "Basic Pagination",
      "code": "<Pagination>\n  <Pagination.List>\n    <Pagination.Link>&laquo;</Pagination.Link>\n    <Pagination.Link active>1</Pagination.Link>\n    <Pagination.Link>2</Pagination.Link>\n    <Pagination.Link>3</Pagination.Link>\n    <Pagination.Ellipsis />\n    <Pagination.Link>10</Pagination.Link>\n    <Pagination.Link>&raquo;</Pagination.Link>\n  </Pagination.List>\n</Pagination>"
    },
    {
      "title": "Sizes",
      "code": "<>\n  <Pagination size=\"small\" mb=\"2\">\n    <Pagination.List>\n      <Pagination.Link>1</Pagination.Link>\n      <Pagination.Link active>2</Pagination.Link>\n      <Pagination.Link>3</Pagination.Link>\n    </Pagination.List>\n  </Pagination>\n  <Pagination size=\"medium\" mb=\"2\">\n    <Pagination.List>\n      <Pagination.Link>1</Pagination.Link>\n      <Pagination.Link active>2</Pagination.Link>\n      <Pagination.Link>3</Pagination.Link>\n    </Pagination.List>\n  </Pagination>\n  <Pagination size=\"large\">\n    <Pagination.List>\n      <Pagination.Link>1</Pagination.Link>\n      <Pagination.Link active>2</Pagination.Link>\n      <Pagination.Link>3</Pagination.Link>\n    </Pagination.List>\n  </Pagination>\n</>"
    },
    {
      "title": "Alignment",
      "code": "<>\n  <Pagination align=\"centered\" mb=\"2\">\n    <Pagination.List>\n      <Pagination.Link>1</Pagination.Link>\n      <Pagination.Link active>2</Pagination.Link>\n      <Pagination.Link>3</Pagination.Link>\n    </Pagination.List>\n  </Pagination>\n  <Pagination align=\"right\">\n    <Pagination.List>\n      <Pagination.Link>1</Pagination.Link>\n      <Pagination.Link active>2</Pagination.Link>\n      <Pagination.Link>3</Pagination.Link>\n    </Pagination.List>\n  </Pagination>\n</>"
    },
    {
      "title": "Rounded",
      "code": "<Pagination rounded>\n  <Pagination.List>\n    <Pagination.Link>1</Pagination.Link>\n    <Pagination.Link active>2</Pagination.Link>\n    <Pagination.Link>3</Pagination.Link>\n  </Pagination.List>\n</Pagination>"
    },
    {
      "title": "With Disabled",
      "code": "<Pagination>\n  <Pagination.List>\n    <Pagination.Link disabled>&laquo;</Pagination.Link>\n    <Pagination.Link active>1</Pagination.Link>\n    <Pagination.Link>2</Pagination.Link>\n    <Pagination.Link>3</Pagination.Link>\n    <Pagination.Ellipsis />\n    <Pagination.Link>10</Pagination.Link>\n    <Pagination.Link>&raquo;</Pagination.Link>\n  </Pagination.List>\n</Pagination>"
    },
    {
      "title": "Controlled Pagination",
      "code": "function example() {\n  const [page, setPage] = useState(1);\n  return (\n    <>\n      <Pagination>\n        <Pagination.Previous\n          disabled={page === 1}\n          onClick={() => setPage(page - 1)}\n        >\n          Previous\n        </Pagination.Previous>\n        <Pagination.Next\n          disabled={page === 5}\n          onClick={() => setPage(page + 1)}\n        >\n          Next\n        </Pagination.Next>\n        <Pagination.List>\n          {[1, 2, 3, 4, 5].map(i => (\n            <Pagination.Link\n              key={i}\n              active={i === page}\n              onClick={() => setPage(i)}\n            >\n              {i}\n            </Pagination.Link>\n          ))}\n        </Pagination.List>\n      </Pagination>\n      <Paragraph mt=\"2\">Current page: {page}</Paragraph>\n    </>\n  );\n}"
    },
    {
      "title": "Previous/Next with Pagination List",
      "code": "<Pagination align=\"centered\">\n  <Pagination.Previous>Previous</Pagination.Previous>\n  <Pagination.Next>Next page</Pagination.Next>\n  <Pagination.List>\n    <Pagination.Link aria-label=\"Goto page 1\">1</Pagination.Link>\n    <Pagination.Ellipsis />\n    <Pagination.Link aria-label=\"Goto page 45\">45</Pagination.Link>\n    <Pagination.Link active aria-label=\"Page 46\">\n      46\n    </Pagination.Link>\n    <Pagination.Link aria-label=\"Goto page 47\">47</Pagination.Link>\n    <Pagination.Ellipsis />\n    <Pagination.Link aria-label=\"Goto page 86\">86</Pagination.Link>\n  </Pagination.List>\n</Pagination>"
    },
    {
      "title": "Compound (dot-notation) usage",
      "code": "<Pagination>\n  <Pagination.Previous>Previous</Pagination.Previous>\n  <Pagination.Next>Next page</Pagination.Next>\n  <Pagination.List>\n    <Pagination.Link active>1</Pagination.Link>\n    <Pagination.Link>2</Pagination.Link>\n    <Pagination.Ellipsis />\n    <Pagination.Link>10</Pagination.Link>\n  </Pagination.List>\n</Pagination>"
    }
  ],
  "accessibility": "- The root `Pagination` renders as a semantic `<nav role=\"navigation\" aria-label=\"pagination\">`.\n- Use `aria-label` on page links for better screen reader support.\n- Disabled and active states are handled with ARIA attributes and classes.\n\n:::note\nPagination links are rendered as `<a>` elements for accessibility and keyboard navigation.\n:::",
  "related": [
    "Button",
    "useBulmaClasses"
  ],
