  "examples": [
    {
      "title": "Basic Steps",
      "code": "<Steps\n  value={1}\n  items={[{ label: 'Account' }, { label: 'Profile' }, { label: 'Complete' }]}\n/>"
    },
    {
      "title": "Clickable Steps",
      "code": "function example() {\n  const [step, setStep] = useState(1);\n  return (\n    <Block>\n      <Steps\n        value={step}\n        items={[\n          { label: 'Account', clickable: true },\n          { label: 'Profile', clickable: true },\n          { label: 'Review', clickable: true },\n          { label: 'Complete', clickable: true },\n        ]}\n        onStepClick={setStep}\n        color=\"primary\"\n      />\n      <Paragraph mt=\"4\">Current step: {step + 1}</Paragraph>\n    </Block>\n  );\n}"
    },
    {
      "title": "Color Variants",
      "code": "<Block display=\"flex\" flexDirection=\"column\" gap=\"5\">\n  <Steps\n    value={1}\n    color=\"primary\"\n    items={[{ label: 'Step 1' }, { label: 'Step 2' }, { label: 'Step 3' }]}\n  />\n  <Steps\n    value={1}\n    color=\"success\"\n    items={[{ label: 'Step 1' }, { label: 'Step 2' }, { label: 'Step 3' }]}\n  />\n  <Steps\n    value={1}\n    color=\"info\"\n    items={[{ label: 'Step 1' }, { label: 'Step 2' }, { label: 'Step 3' }]}\n  />\n  <Steps\n    value={1}\n    color=\"warning\"\n    items={[{ label: 'Step 1' }, { label: 'Step 2' }, { label: 'Step 3' }]}\n  />\n  <Steps\n    value={1}\n    color=\"danger\"\n    items={[{ label: 'Step 1' }, { label: 'Step 2' }, { label: 'Step 3' }]}\n  />\n</Block>"
    },
    {
      "title": "Size Variants",
      "code": "<Block display=\"flex\" flexDirection=\"column\" gap=\"5\">\n  <Steps\n    value={1}\n    size=\"small\"\n    items={[{ label: 'Step 1' }, { label: 'Step 2' }, { label: 'Step 3' }]}\n  />\n  <Steps\n    value={1}\n    items={[{ label: 'Step 1' }, { label: 'Step 2' }, { label: 'Step 3' }]}\n  />\n  <Steps\n    value={1}\n    size=\"medium\"\n    items={[{ label: 'Step 1' }, { label: 'Step 2' }, { label: 'Step 3' }]}\n  />\n  <Steps\n    value={1}\n    size=\"large\"\n    items={[{ label: 'Step 1' }, { label: 'Step 2' }, { label: 'Step 3' }]}\n  />\n</Block>"
    },
    {
      "title": "With Icons",
      "code": "<Steps\n  value={1}\n  color=\"info\"\n  items={[\n    { label: 'Cart', icon: <Icon name=\"shopping-cart\" variant=\"solid\" /> },\n    { label: 'Shipping', icon: <Icon name=\"truck\" variant=\"solid\" /> },\n    { label: 'Payment', icon: <Icon name=\"credit-card\" variant=\"solid\" /> },\n    { label: 'Done', icon: <Icon name=\"check\" variant=\"solid\" /> },\n  ]}\n/>"
    },
    {
      "title": "Vertical Layout",
      "code": "<Steps\n  value={1}\n  vertical\n  color=\"primary\"\n  items={[\n    { label: 'Create Account' },\n    { label: 'Set Up Profile' },\n    { label: 'Choose Plan' },\n    { label: 'Start Using' },\n  ]}\n/>"
    },
    {
      "title": "Rounded Markers",
      "code": "<Steps\n  value={2}\n  rounded\n  color=\"success\"\n  items={[\n    { label: 'Order Placed' },\n    { label: 'Processing' },\n    { label: 'Shipped' },\n    { label: 'Delivered' },\n  ]}\n/>"
    },
    {
      "title": "Checkout Flow Example",
      "code": "function example() {\n  const [step, setStep] = useState(0);\n  const steps = ['Cart', 'Shipping', 'Payment', 'Confirm'];\n\n  return (\n    <Block>\n      <Steps\n        value={step}\n        items={steps.map((label, i) => ({ label, clickable: i <= step }))}\n        onStepClick={s => s <= step && setStep(s)}\n        color=\"primary\"\n      />\n      <Box mt=\"4\" p=\"4\">\n        <Title size=\"5\">{steps[step]}</Title>\n        <Paragraph>Content for the {steps[step]} step goes here.</Paragraph>\n      </Box>\n      <Buttons mt=\"4\">\n        <Button\n          onClick={() => setStep(Math.max(0, step - 1))}\n          disabled={step === 0}\n        >\n          Previous\n        </Button>\n        <Button\n          color=\"primary\"\n          onClick={() => setStep(Math.min(3, step + 1))}\n          disabled={step === 3}\n        >\n          {step === 2 ? 'Place Order' : 'Next'}\n        </Button>\n      </Buttons>\n    </Block>\n  );\n}"
    },
    {
      "title": "Compound (dot-notation) usage",
      "code": "<Steps value={1}>\n  <Steps.Step label=\"Account\" />\n  <Steps.Step label=\"Profile\" />\n  <Steps.Step label=\"Complete\" />\n</Steps>"
    }
  ],
  "accessibility": "- Steps use `aria-current=\"step\"` on the active step\n- Clickable steps are keyboard navigable with proper focus indicators\n- Use descriptive labels for each step\n- The step markers show completion state with checkmarks",
