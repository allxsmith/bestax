  "docsUrl": "https://bestax.io/docs/api/form/radio",
  "examples": [
    {
      "title": "Mutually Exclusive Radios (Only One Can Be Selected)",
      "code": "<Control>\n  <Radio name=\"mutuallyExclusive\"> Yes </Radio>\n  <Radio name=\"mutuallyExclusive\"> No </Radio>\n  <Radio name=\"mutuallyExclusive\"> Maybe </Radio>\n</Control>"
    },
    {
      "title": "Default Selected Radio",
      "code": "<Control>\n  <Radio name=\"pet\"> Cat </Radio>\n  <Radio name=\"pet\" defaultChecked>\n    {' '}\n    Dog{' '}\n  </Radio>\n</Control>"
    },
    {
      "title": "Disabled Radios",
      "code": "<Control>\n  <Radio name=\"response\" disabled>\n    {' '}\n    Attend{' '}\n  </Radio>\n  <Radio name=\"response\" disabled>\n    {' '}\n    Decline{' '}\n  </Radio>\n  <Radio name=\"response\" disabled>\n    {' '}\n    Tentative{' '}\n  </Radio>\n</Control>"
    },
    {
      "title": "List of Radios (Grouped with the `Radios` Wrapper)",
      "code": "<Radios>\n  <Radio name=\"event\" disabled>\n    {' '}\n    Attend{' '}\n  </Radio>\n  <Radio name=\"event\" disabled>\n    {' '}\n    Decline{' '}\n  </Radio>\n  <Radio name=\"event\" disabled>\n    {' '}\n    Tentative{' '}\n  </Radio>\n</Radios>"
    }
  ],
  "accessibility": "- Each `Radio` is rendered as a `<label>` wrapping an `<input type=\"radio\">` and the label text, for optimal accessibility.\n- Use the same `name` prop for a group of radios to ensure only one can be selected.",
