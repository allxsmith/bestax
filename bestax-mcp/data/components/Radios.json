  "examples": [
    {
      "title": "Grouped Radios (All Disabled Example)",
      "code": "<Radios>\n  <Radio name=\"event\" disabled>\n    {' '}\n    Attend{' '}\n  </Radio>\n  <Radio name=\"event\" disabled>\n    {' '}\n    Decline{' '}\n  </Radio>\n  <Radio name=\"event\" disabled>\n    {' '}\n    Tentative{' '}\n  </Radio>\n</Radios>"
    },
    {
      "title": "Context-Aware Rendering",
      "code": "<Radios label=\"RSVP\">\n  <Radio name=\"rsvp\"> Attend </Radio>\n  <Radio name=\"rsvp\"> Decline </Radio>\n  <Radio name=\"rsvp\"> Tentative </Radio>\n</Radios>"
    },
    {
      "title": "Context-Aware Rendering",
      "code": "function example() {\n  return (\n    <Field horizontal label=\"RSVP\">\n      <Field.Body>\n        <Field>\n          <Radios>\n            <Radio name=\"rsvp2\"> Attend </Radio>\n            <Radio name=\"rsvp2\"> Decline </Radio>\n            <Radio name=\"rsvp2\"> Tentative </Radio>\n          </Radios>\n        </Field>\n      </Field.Body>\n    </Field>\n  );\n}"
    },
    {
      "title": "Context-Aware Rendering",
      "code": "function example() {\n  return (\n    <Field horizontal label=\"RSVP\">\n      <Field.Body>\n        <Field>\n          <Control>\n            <Radios>\n              <Radio name=\"rsvp3\"> Attend </Radio>\n              <Radio name=\"rsvp3\"> Decline </Radio>\n              <Radio name=\"rsvp3\"> Tentative </Radio>\n            </Radios>\n          </Control>\n        </Field>\n      </Field.Body>\n    </Field>\n  );\n}"
    },
    {
      "title": "Compound (dot-notation) usage",
      "code": "<Radios name=\"color\" label=\"Favorite color\">\n  <Radios.Radio value=\"red\">Red</Radios.Radio>\n  <Radios.Radio value=\"green\">Green</Radios.Radio>\n</Radios>"
    }
  ],
  "accessibility": "- The group is rendered as a `<div class=\"radios\">` containing labeled radio buttons.\n- Each child should be a `Radio` for proper labeling and accessibility.\n- Use the same `name` for all radios in a group to ensure mutual exclusivity.",
