{
  "name": "Control",
  "kind": "component",
  "category": "form",
  "slug": "form/control",
  "docsUrl": "https://bestax.io/docs/api/form/control",
  "examples": [
    {
      "title": "With Input",
      "code": "<Field label=\"Default\">\n  <Control>\n    <Input placeholder=\"Default input\" />\n  </Control>\n</Field>"
    },
    {
      "title": "With Select",
      "code": "<Field label=\"Default\">\n  <Control>\n    <Select>\n      <option value=\"\">Please select</option>\n      <option value=\"option1\">Option 1</option>\n      <option value=\"option2\">Option 2</option>\n    </Select>\n  </Control>\n</Field>"
    },
    {
      "title": "With TextArea",
      "code": "<Field label=\"Default\">\n  <Control>\n    <TextArea placeholder=\"Write here...\" />\n  </Control>\n</Field>"
    },
    {
      "title": "With Icons (Left and Right)",
      "code": "<Field>\n  <Control\n    hasIconsLeft\n    hasIconsRight\n    iconLeft={{ name: 'user' }}\n    iconRight={{ name: 'check' }}\n  >\n    <Input placeholder=\"With icons\" />\n  </Control>\n</Field>"
    },
    {
      "title": "With Only Left Icon (Shortcut Props)",
      "code": "<Field>\n  <Control hasIconsLeft iconLeftName=\"user\" iconLeftSize=\"small\">\n    <Input size=\"small\" placeholder=\"With left icon shortcut\" />\n  </Control>\n</Field>"
    },
    {
      "title": "With Only Right Icon (Shortcut Props)",
      "code": "<Field>\n  <Control hasIconsRight iconRightName=\"check\" iconRightSize=\"small\">\n    <Input size=\"small\" placeholder=\"With right icon shortcut\" />\n  </Control>\n</Field>"
    },
    {
      "title": "With Icons and Size Variations",
      "code": "<Field>\n  <Control\n    hasIconsLeft\n    hasIconsRight\n    size=\"medium\"\n    iconLeft={{ name: 'user', size: 'medium' }}\n    iconRight={{ name: 'check', size: 'medium' }}\n  >\n    <Input size=\"medium\" placeholder=\"Icons left/right medium\" />\n  </Control>\n</Field>"
    },
    {
      "title": "Loading State",
      "code": "<Field label=\"Loading\">\n  <Control isLoading>\n    <Input placeholder=\"Loading state\" />\n  </Control>\n</Field>"
    },
    {
      "title": "Loading State with Size Variations",
      "code": "<>\n  <Field label=\"Loading Small\">\n    <Control isLoading size=\"small\">\n      <Input size=\"small\" placeholder=\"Loading small\" />\n    </Control>\n  </Field>\n\n  <Field label=\"Loading Medium\">\n    <Control isLoading size=\"medium\">\n      <Input size=\"medium\" placeholder=\"Loading medium\" />\n    </Control>\n  </Field>\n\n  <Field label=\"Loading Large\">\n    <Control isLoading size=\"large\">\n      <Input size=\"large\" placeholder=\"Loading large\" />\n    </Control>\n  </Field>\n</>"
    },
    {
      "title": "Expanded Control",
      "code": "<Field label=\"Expanded\">\n  <Control isExpanded>\n    <Input placeholder=\"Expands to fill available space\" />\n  </Control>\n</Field>"
    },
    {
      "title": "Control as Paragraph (`as=\"p\"`)",
      "code": "<Field label=\"Control as Paragraph\">\n  <Control as=\"p\">\n    <Input placeholder=\"Inside a <p> element\" />\n  </Control>\n</Field>"
    },
    {
      "title": "With Radios or Checkboxes",
      "code": "<>\n  <Field label=\"Options\">\n    <Control>\n      <Radio name=\"option\">Option 1</Radio>\n      <Radio name=\"option\">Option 2</Radio>\n    </Control>\n  </Field>\n\n  <Field label=\"Preferences\">\n    <Control>\n      <Checkbox>Enable notifications</Checkbox>\n      <Checkbox>Subscribe to newsletter</Checkbox>\n    </Control>\n  </Field>\n</>"
    }
  ],
  "accessibility": "- `Control` provides only visual and layout structure; ensure you use associated `Field` and `label` for accessible form labeling.\n- Icons are decorative by default. Add ARIA attributes to icons if needed for accessibility.",
  "related": [
    "Checkbox",
    "Field",
    "Input",
    "Radio",
    "Select",
    "TextArea",
    "useBulmaClasses"
  ],
  "storybook": "https://bestax.io/storybook/?path=/story/form-input--default",
  "summary": "The `Control` component is a Bulma-styled wrapper for form controls (`Input`, `Select`, `TextArea`, etc.), supporting icons (left/right), loading state, expansion, size, and Bulma helper props for layout and color.",
