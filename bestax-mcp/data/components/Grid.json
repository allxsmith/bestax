  "examples": [
    {
      "title": "Smart Grid",
      "code": "<Grid>\n  {[...Array(24)].map((_, i) => (\n    <Cell key={i}>\n      <Notification color=\"primary\">Cell {i + 1}</Notification>\n    </Cell>\n  ))}\n</Grid>"
    },
    {
      "title": "Minimum Column Width",
      "code": "<Grid minCol={4}>\n  {[...Array(24)].map((_, i) => (\n    <Cell key={i}>\n      <Notification color=\"primary\" textSize=\"7\">\n        Cell {i + 1}\n      </Notification>\n    </Cell>\n  ))}\n</Grid>"
    },
    {
      "title": "Gap",
      "code": "<Grid gap={2}>\n  {[...Array(24)].map((_, i) => (\n    <Cell key={i}>\n      <Notification color=\"primary\">Cell {i + 1}</Notification>\n    </Cell>\n  ))}\n</Grid>"
    },
    {
      "title": "Column Gap",
      "code": "<Grid columnGap={2}>\n  {[...Array(24)].map((_, i) => (\n    <Cell key={i}>\n      <Notification color=\"primary\">Cell {i + 1}</Notification>\n    </Cell>\n  ))}\n</Grid>"
    },
    {
      "title": "Row Gap",
      "code": "<Grid rowGap={2}>\n  {[...Array(24)].map((_, i) => (\n    <Cell key={i}>\n      <Notification color=\"primary\">Cell {i + 1}</Notification>\n    </Cell>\n  ))}\n</Grid>"
    },
    {
      "title": "Fixed Grid",
      "code": "<Grid isFixed>\n  {[...Array(12)].map((_, i) => (\n    <Cell key={i}>\n      <Notification color=\"primary\">Cell {i + 1}</Notification>\n    </Cell>\n  ))}\n</Grid>"
    },
    {
      "title": "Fixed Grid Cols",
      "code": "<Grid isFixed fixedCols={4}>\n  {[...Array(12)].map((_, i) => (\n    <Cell key={i}>\n      <Notification color=\"primary\">Cell {i + 1}</Notification>\n    </Cell>\n  ))}\n</Grid>"
    },
    {
      "title": "Fixed Grid Cols By Breakpoint",
      "code": "<Grid\n  isFixed\n  fixedCols={4}\n  fixedColsMobile={4}\n  fixedColsTablet={6}\n  fixedColsDesktop={8}\n  fixedColsWidescreen={10}\n  fixedColsFullhd={12}\n>\n  {[...Array(12)].map((_, i) => (\n    <Cell key={i}>\n      <Notification color=\"primary\">Cell {i + 1}</Notification>\n    </Cell>\n  ))}\n</Grid>"
    },
    {
      "title": "Fixed Grid Auto Count",
      "code": "<Grid isFixed fixedCols=\"auto\">\n  {[...Array(16)].map((_, i) => (\n    <Cell key={i}>\n      <Notification color=\"primary\">Cell {i + 1}</Notification>\n    </Cell>\n  ))}\n</Grid>"
    },
    {
      "title": "Compound (dot-notation) usage",
      "code": "<Grid>\n  <Grid.Cell>\n    <Notification color=\"primary\">Cell 1</Notification>\n  </Grid.Cell>\n  <Grid.Cell>\n    <Notification color=\"info\">Cell 2</Notification>\n  </Grid.Cell>\n</Grid>"
    }
  ],
