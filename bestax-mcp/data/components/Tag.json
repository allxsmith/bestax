    { "title": "Default Tag", "code": "<Tag>Default Tag</Tag>" },
    {
      "title": "Colored Tag",
      "code": "<Tag color=\"primary\">Primary Tag</Tag>"
    },
    {
      "title": "Medium and Large Tag",
      "code": "<Tags>\n  <Tag size=\"medium\">Medium Tag</Tag>\n  <Tag size=\"large\">Large Tag</Tag>\n</Tags>"
    },
    { "title": "Rounded Tag", "code": "<Tag isRounded>Rounded Tag</Tag>" },
    {
      "title": "Delete Tag (Button)",
      "code": "<Tag isDelete onDelete={() => alert('Deleted!')} />"
    },
    { "title": "With Margin", "code": "<Tag m=\"4\">Tag with Margin</Tag>" },
    {
      "title": "Combined Styles",
      "code": "<Tag color=\"success\" size=\"medium\" isRounded m=\"2\">\n  Combined Tag\n</Tag>"
    },
    {
      "title": "All Colors",
      "code": "<Tags>\n  {[\n    'primary',\n    'link',\n    'info',\n    'success',\n    'warning',\n    'danger',\n    'black',\n    'dark',\n    'light',\n    'white',\n  ].map(color => (\n    <Tag key={color} color={color} isHoverable>\n      {color.charAt(0).toUpperCase() + color.slice(1)}\n    </Tag>\n  ))}\n</Tags>"
    },
    {
      "title": "Sizes Together",
      "code": "<Block>\n  {['primary', 'success', 'danger'].map(color => (\n    <Tags key={color}>\n      <Tag color={color} size=\"normal\" isHoverable>\n        {color.charAt(0).toUpperCase() + color.slice(1)} Normal\n      </Tag>\n      <Tag color={color} size=\"medium\" isHoverable>\n        {color.charAt(0).toUpperCase() + color.slice(1)} Medium\n      </Tag>\n      <Tag color={color} size=\"large\" isHoverable>\n        {color.charAt(0).toUpperCase() + color.slice(1)} Large\n      </Tag>\n    </Tags>\n  ))}\n</Block>"
    },
    {
      "title": "Hoverable Tag",
      "code": "<Tag color=\"primary\" isHoverable>\n  Hoverable Tag\n</Tag>"
    },
    {
      "title": "Tag with Delete Component",
      "code": "import { Tags, Delete } from '@allxsmith/bestax-bulma';\n\n<Tags hasAddons>\n  <Tag color=\"primary\" size=\"medium\">\n    Tag with Delete\n    <Delete onClick={() => alert('Tag deleted!')} />\n  </Tag>\n</Tags>;"
    }
  ],
  "accessibility": "- **Delete buttons:** Use `aria-label` for delete tags for screen readers.\n- **Keyboard:** Delete tags are rendered as `<button>`, supporting keyboard activation.\n- **Semantics:** Use tags for supplemental information, not as primary headings.\n\n:::tip\nCombine `Tag` with `Tags` for grouped, multi-tag UIs.\n:::",
