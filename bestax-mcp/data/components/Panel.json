{
  "name": "Panel",
  "kind": "component",
  "category": "components",
  "slug": "components/panel",
  "docsUrl": "https://bestax.io/docs/api/components/panel",
  "examples": [
    {
      "title": "Complete Panel (Revolutionary Figures)",
      "code": "<Panel>\n  <Panel.Heading>Revolutionary Figures</Panel.Heading>\n  <Panel.InputBlock placeholder=\"Search\" />\n  <Panel.Tabs>\n    <a className=\"is-active\">All</a>\n    <a>Patriots</a>\n    <a>Loyalists</a>\n    <a>Battles</a>\n    <a>Documents</a>\n  </Panel.Tabs>\n  <Panel.Block active>\n    <Panel.Icon name=\"user\" variant=\"solid\" />\n    George Washington\n  </Panel.Block>\n  <Panel.Block>\n    <Panel.Icon name=\"user\" variant=\"solid\" />\n    Alexander Hamilton\n  </Panel.Block>\n  <Panel.Block>\n    <Panel.Icon name=\"user\" variant=\"solid\" />\n    Benedict Arnold\n  </Panel.Block>\n  <Panel.Block>\n    <Panel.Icon name=\"user\" variant=\"solid\" />\n    John Adams\n  </Panel.Block>\n  <Panel.Block>\n    <Panel.Icon name=\"flag\" variant=\"solid\" />\n    Battle of Saratoga\n  </Panel.Block>\n  <Panel.Block>\n    <Panel.Icon name=\"flag\" variant=\"solid\" />\n    Treaty of Paris\n  </Panel.Block>\n  <Panel.Block>\n    <Panel.Icon name=\"flag\" variant=\"solid\" />\n    Bunker Hill\n  </Panel.Block>\n  <Panel.CheckboxBlock>remember me</Panel.CheckboxBlock>\n  <Panel.ButtonBlock>Reset all filters</Panel.ButtonBlock>\n</Panel>"
    },
    {
      "title": "Color Variants",
      "code": "<>\n  {[\n    'primary',\n    'link',\n    'info',\n    'success',\n    'warning',\n    'danger',\n    'black',\n    'dark',\n    'light',\n    'white',\n  ].map(color => (\n    <Panel key={color} color={color}>\n      <Panel.Heading>\n        {color.charAt(0).toUpperCase() + color.slice(1)} Panel\n      </Panel.Heading>\n      <Panel.InputBlock placeholder=\"Search\" />\n      <Panel.Block active>\n        <Panel.Icon name=\"user\" variant=\"solid\" />\n        George Washington\n      </Panel.Block>\n      <Panel.Block>\n        <Panel.Icon name=\"user\" variant=\"solid\" />\n        Marquis de Lafayette\n      </Panel.Block>\n      <Panel.Block>\n        <Panel.Icon name=\"user\" variant=\"solid\" />\n        Nathanael Greene\n      </Panel.Block>\n      <Panel.Block>\n        <Panel.Icon name=\"flag\" variant=\"solid\" />\n        Battle of Trenton\n      </Panel.Block>\n      <Panel.Block>\n        <Panel.Icon name=\"flag\" variant=\"solid\" />\n        Yorktown\n      </Panel.Block>\n      <Panel.ButtonBlock>Reset all filters</Panel.ButtonBlock>\n    </Panel>\n  ))}\n</>"
    },
    {
      "title": "Compound (dot-notation) usage",
      "code": "<Panel>\n  <Panel.Heading>Founding Documents</Panel.Heading>\n  <Panel.Block active>\n    <Panel.Icon name=\"file\" variant=\"solid\" />\n    Declaration of Independence\n  </Panel.Block>\n  <Panel.Block>\n    <Panel.Icon name=\"file\" variant=\"solid\" />\n    Articles of Confederation\n  </Panel.Block>\n  <Panel.ButtonBlock>Reset all filters</Panel.ButtonBlock>\n</Panel>"
    }
  ],
  "accessibility": "- The root panel renders as a semantic `<nav>` for navigation/landmark.\n- Use headings, links, and buttons with appropriate labels for best accessibility.\n- The `Panel.Block` by default renders as an anchor `<a>`, but can be customized for interactive blocks.\n\n:::note\nFor keyboard navigation, ensure interactive Panel blocks are focusable and provide clear visual states.\n:::",
  "related": [
    "Icon",
    "useBulmaClasses"
  ],
