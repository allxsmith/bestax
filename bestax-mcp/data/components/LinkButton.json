{
  "name": "LinkButton",
  "kind": "component",
  "category": "elements",
  "slug": "elements/linkbutton",
  "docsUrl": "https://bestax.io/docs/api/elements/linkbutton",
  "examples": [
    {
      "title": "Default (Text Variant)",
      "code": "<LinkButton>Click me</LinkButton>"
    },
    {
      "title": "Ghost Variant",
      "code": "<LinkButton variant=\"ghost\">Ghost LinkButton</LinkButton>"
    },
    {
      "title": "Underline Variant",
      "code": "<LinkButton variant=\"underline\">Go back and edit</LinkButton>"
    },
    {
      "title": "Text Variant with Color",
      "code": "<LinkButton color=\"primary\">Primary Text</LinkButton>"
    },
    {
      "title": "Ghost Variant with Color",
      "code": "<LinkButton variant=\"ghost\" color=\"danger\">\n  Danger Ghost\n</LinkButton>"
    },
    {
      "title": "All Colors",
      "code": "<Buttons>\n  {['primary', 'link', 'info', 'success', 'warning', 'danger'].map(color => (\n    <LinkButton key={color} color={color}>\n      {color.charAt(0).toUpperCase() + color.slice(1)}\n    </LinkButton>\n  ))}\n</Buttons>"
    },
    {
      "title": "Disabled",
      "code": "<LinkButton isDisabled disabled>\n  Disabled LinkButton\n</LinkButton>"
    },
    {
      "title": "All Sizes",
      "code": "<Buttons>\n  {['small', 'normal', 'medium', 'large'].map(size => (\n    <LinkButton key={size} size={size}>\n      {size.charAt(0).toUpperCase() + size.slice(1)}\n    </LinkButton>\n  ))}\n</Buttons>"
    },
    {
      "title": "Polymorphic `as` (Router Links)",
      "code": "import { Link as RouterLink } from 'react-router-dom';\nimport { LinkButton } from '@allxsmith/bestax-bulma';\n\n<LinkButton as={RouterLink} to=\"/dashboard\" variant=\"underline\">\n  Go to Dashboard\n</LinkButton>;"
    }
  ],
  "accessibility": "- **Semantic HTML:** Renders a native `<button>` element, providing correct keyboard navigation, focus management, and screen reader announcements.\n- **States:** The `isDisabled` and `disabled` props ensure correct `aria-disabled` and `disabled` attributes.\n- **Keyboard:** Fully keyboard accessible with Enter and Space activation.\n- **Replaces anti-patterns:** Use this instead of `<div onClick>` or `<span onClick>` for interactive elements that should not navigate.\n\n:::note\nIf your LinkButton has only an icon, use `aria-label` to provide accessible text.\n:::",
  "related": ["Button", "Buttons", "useBulmaClasses"],
  "storybook": "https://bestax.io/storybook/?path=/story/elements-linkbutton--default",
  "summary": "The `LinkButton` component renders a `<button>` that visually looks like text or a link.",
