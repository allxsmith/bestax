  "examples": [
    {
      "title": "Default Button",
      "code": "<Button>Default Button</Button>"
    },
    {
      "title": "All Colors",
      "code": "import { Buttons } from './Buttons';\n\n<Buttons>\n  {['primary', 'link', 'info', 'success', 'warning', 'danger'].map(color => (\n    <Button key={color} color={color}>\n      {color.charAt(0).toUpperCase() + color.slice(1)}\n    </Button>\n  ))}\n</Buttons>;"
    },
    {
      "title": "All Sizes",
      "code": "<Buttons>\n  {['small', 'normal', 'medium', 'large'].map(size => (\n    <Button key={size} size={size}>\n      {size.charAt(0).toUpperCase() + size.slice(1)}\n    </Button>\n  ))}\n</Buttons>"
    },
    {
      "title": "Light Variant",
      "code": "<Button color=\"primary\" isLight>\n  Light Primary Button\n</Button>"
    },
    {
      "title": "Rounded",
      "code": "<Button color=\"info\" isRounded>\n  Rounded Button\n</Button>"
    },
    {
      "title": "Loading",
      "code": "<Button color=\"success\" isLoading>\n  Loading Button\n</Button>"
    },
    {
