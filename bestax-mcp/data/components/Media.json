{
  "name": "Media",
  "kind": "component",
  "category": "layout",
  "slug": "layout/media",
  "docsUrl": "https://bestax.io/docs/api/layout/media",
  "examples": [
    {
      "title": "Default Media",
      "code": "<Media>\n  <Media.Left>\n    <Image\n      as=\"p\"\n      size=\"64x64\"\n      src=\"https://bulma.io/assets/images/placeholders/128x128.png\"\n      alt=\"\"\n    />\n  </Media.Left>\n  <Media.Content>\n    <Content>\n      <Paragraph>\n        <Strong>Alexander Hamilton</Strong> <small>@hamilton</small>{' '}\n        <small>31m</small>\n        <br />\n        If men were angels, no government would be necessary. If angels were to\n        govern men, neither external nor internal controls on government would\n        be necessary.\n      </Paragraph>\n    </Content>\n    <Level isMobile>\n      <Level.Left>\n        <Level.Item as=\"a\">\n          <Icon name=\"reply\" variant=\"solid\" size=\"small\" />\n        </Level.Item>\n        <Level.Item as=\"a\">\n          <Icon name=\"retweet\" variant=\"solid\" size=\"small\" />\n        </Level.Item>\n        <Level.Item as=\"a\">\n          <Icon name=\"heart\" variant=\"solid\" size=\"small\" />\n        </Level.Item>\n      </Level.Left>\n    </Level>\n  </Media.Content>\n  <Media.Right>\n    <Delete aria-label=\"delete\" />\n  </Media.Right>\n</Media>"
    },
    {
      "title": "Media With Inputs",
      "code": "<Media>\n  <Media.Left>\n    <Image\n      as=\"p\"\n      size=\"64x64\"\n      src=\"https://bulma.io/assets/images/placeholders/128x128.png\"\n      alt=\"\"\n    />\n  </Media.Left>\n  <Media.Content>\n    <Field>\n      <Control as=\"p\">\n        <TextArea placeholder=\"Add a comment...\" />\n      </Control>\n    </Field>\n    <Level>\n      <Level.Left>\n        <Level.Item>\n          <Button as=\"a\" color=\"info\">\n            Submit\n          </Button>\n        </Level.Item>\n      </Level.Left>\n      <Level.Right>\n        <Level.Item>\n          <Checkbox>Press enter to submit</Checkbox>\n        </Level.Item>\n      </Level.Right>\n    </Level>\n  </Media.Content>\n</Media>"
    },
    {
      "title": "Nested Media",
      "code": "<Media>\n  <Media.Left>\n    <Image\n      as=\"p\"\n      size=\"64x64\"\n      src=\"https://bulma.io/assets/images/placeholders/128x128.png\"\n      alt=\"\"\n    />\n  </Media.Left>\n  <Media.Content>\n    <Content>\n      <Paragraph>\n        <Strong>John Jay</Strong>\n        <br />\n        The people, in their collective capacity, are the ultimate authority.\n        The Union is essential to the security of the people of America against\n        foreign danger.\n        <br />\n        <small>\n          <a>Like</a> &middot; <a>Reply</a> &middot; 3 hrs\n        </small>\n      </Paragraph>\n    </Content>\n    {/* First nested media */}\n    <Media>\n      <Media.Left>\n        <Image\n          as=\"p\"\n          size=\"48x48\"\n          src=\"https://bulma.io/assets/images/placeholders/96x96.png\"\n          alt=\"\"\n        />\n      </Media.Left>\n      <Media.Content>\n        <Content>\n          <Paragraph>\n            <Strong>James Madison</Strong>\n            <br />\n            The accumulation of all powers, legislative, executive, and\n            judiciary, in the same hands, may justly be pronounced the very\n            definition of tyranny.\n            <br />\n            <small>\n              <a>Like</a> &middot; <a>Reply</a> &middot; 2 hrs\n            </small>\n          </Paragraph>\n        </Content>\n        {/* 2nd nested media (two siblings) */}\n        <Media>\n          Experience has taught mankind the necessity of auxiliary precautions.\n        </Media>\n        <Media>Ambition must be made to counteract ambition.</Media>\n      </Media.Content>\n    </Media>\n    {/* Second nested media */}\n    <Media>\n      <Media.Left>\n        <Image\n          as=\"p\"\n          size=\"48x48\"\n          src=\"https://bulma.io/assets/images/placeholders/96x96.png\"\n          alt=\"\"\n        />\n      </Media.Left>\n      <Media.Content>\n        <Content>\n          <Paragraph>\n            <Strong>Alexander Hamilton</Strong>\n            <br />\n            Safety from external danger is the most powerful director of\n            national conduct. The desire for respect and security will always\n            influence the policy of nations.\n            <br />\n            <small>\n              <a>Like</a> &middot; <a>Reply</a> &middot; 2 hrs\n            </small>\n          </Paragraph>\n        </Content>\n      </Media.Content>\n    </Media>\n  </Media.Content>\n</Media>"
    },
    {
      "title": "Media With Button Below",
      "code": "<Media>\n  <Media.Left>\n    <Image\n      as=\"p\"\n      size=\"64x64\"\n      src=\"https://bulma.io/assets/images/placeholders/128x128.png\"\n      alt=\"\"\n    />\n  </Media.Left>\n  <Media.Content>\n    <Field>\n      <Control as=\"p\">\n        <TextArea placeholder=\"Add a comment...\" />\n      </Control>\n    </Field>\n    <Field>\n      <Control as=\"p\">\n        <Button>Post comment</Button>\n      </Control>\n    </Field>\n  </Media.Content>\n</Media>"
    },
    {
      "title": "Compound (dot-notation) usage",
      "code": "<Media>\n  <Media.Left>\n    <Image\n      as=\"p\"\n      size=\"64x64\"\n      src=\"https://bulma.io/assets/images/placeholders/128x128.png\"\n      alt=\"\"\n    />\n  </Media.Left>\n  <Media.Content>\n    <Content>\n      <p>\n        <strong>John Smith</strong> <small>@johnsmith</small>\n        <br />\n        Composed entirely from the single Media import via dot notation.\n      </p>\n    </Content>\n  </Media.Content>\n  <Media.Right>\n    <Button as=\"a\" size=\"small\">\n      Reply\n    </Button>\n  </Media.Right>\n</Media>"
    }
  ],
  "accessibility": "- The Media root renders as a semantic `<article>` by default. Use `as=\"div\"` for a generic container.\n- The left section is commonly used for avatars (as `<figure>`) and is screen-reader accessible.\n- Use clear and descriptive text in content and actions for best accessibility.\n\n:::note\nWhen using only icons or controls, provide `aria-label` or screen-reader-only content as appropriate.\n:::",
  "related": [
    "Button",
    "Checkbox",
    "Image",
    "Level",
    "TextArea",
    "useBulmaClasses"
  ],
